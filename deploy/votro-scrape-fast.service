[Unit]
Description=VotRO fast vote scrape (both chambers only)
After=network-online.target
Wants=network-online.target

[Service]
# cdep.ro serves the wrong certSIGN intermediate; trust the system store (has Web CA G2) instead of certifi.
Environment=REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
Environment=SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
Type=oneshot
User=votro
WorkingDirectory=/opt/votro
ExecStart=/opt/votro/deploy/run_daily.sh --fast
# Votes only — ~40s. Anything slower means a chamber page is hanging, not that
# there is more work to do, so a tight timeout is the right signal here (unlike
# the full run, which is an open-ended batch job).
TimeoutStartSec=10min
